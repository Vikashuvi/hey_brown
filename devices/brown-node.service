[Unit]
Description=Brown AI Assistant - Remote Inference & Capability Node Daemon
After=network.target graphical-session.target ollama.service
Wants=ollama.service

[Service]
Type=simple
WorkingDirectory=%h/brown-agent
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
ExecStart=/usr/bin/python3 %h/brown-agent/remote_daemon.py --port 8765
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
